{
  "openapi": "3.1.0",
  "info": {
    "title": "Rollo API",
    "version": "0.2.0",
    "description": "Rollo backend: trips, shared rolls and the reveal at the end."
  },
  "servers": [
    {
      "url": "https://rollo-api.juanifraga.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token returned when creating or joining a trip"
      }
    },
    "schemas": {
      "TripCreated": {
        "type": "object",
        "properties": {
          "trip": {
            "$ref": "#/components/schemas/Trip"
          },
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "token": {
            "type": "string",
            "description": "Store it on the phone: it is only returned once"
          }
        },
        "required": [
          "trip",
          "member",
          "token"
        ]
      },
      "Trip": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Viaje al sur"
          },
          "joinCode": {
            "type": "string",
            "example": "HUB5FT",
            "description": "6-character code to join"
          },
          "timezone": {
            "type": "string",
            "example": "America/Argentina/Buenos_Aires"
          },
          "startsAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Trip start",
            "example": 1767225600000
          },
          "endsAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Trip end",
            "example": 1767225600000
          },
          "revealAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Automatic reveal",
            "example": 1767225600000
          },
          "revealed": {
            "type": "boolean"
          },
          "dailyPhotoLimit": {
            "type": "integer"
          },
          "dailyVideoLimit": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "joinCode",
          "timezone",
          "startsAt",
          "endsAt",
          "revealAt",
          "revealed",
          "dailyPhotoLimit",
          "dailyVideoLimit"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Fede"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "member"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Código inválido"
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateTripRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "example": "Viaje al sur"
          },
          "adminName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "example": "Juani"
          },
          "timezone": {
            "type": "string",
            "example": "America/Argentina/Buenos_Aires",
            "description": "IANA time zone of the destination"
          },
          "startsAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Trip start",
            "example": 1767225600000
          },
          "endsAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Trip end; must be after startsAt",
            "example": 1767225600000
          },
          "revealAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "When the roll is revealed; must be >= endsAt",
            "example": 1767225600000
          },
          "dailyPhotoLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          },
          "dailyVideoLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 3
          }
        },
        "required": [
          "name",
          "adminName",
          "timezone",
          "startsAt",
          "endsAt",
          "revealAt"
        ]
      },
      "JoinTripRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 6,
            "maxLength": 6,
            "example": "HUB5FT"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "example": "Juani"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "TripDetail": {
        "type": "object",
        "properties": {
          "trip": {
            "$ref": "#/components/schemas/Trip"
          },
          "me": {
            "$ref": "#/components/schemas/Member"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "today": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "example": "2027-01-12",
                "description": "Trip's local date"
              },
              "photosLeft": {
                "type": "integer"
              },
              "videosLeft": {
                "type": "integer"
              }
            },
            "required": [
              "date",
              "photosLeft",
              "videosLeft"
            ]
          },
          "totalUploaded": {
            "type": "integer"
          }
        },
        "required": [
          "trip",
          "me",
          "members",
          "today",
          "totalUploaded"
        ]
      },
      "TripResponse": {
        "type": "object",
        "properties": {
          "trip": {
            "$ref": "#/components/schemas/Trip"
          }
        },
        "required": [
          "trip"
        ]
      },
      "UpdateTripRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "endsAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Trip end; must be after startsAt and <= the resulting revealAt"
          },
          "revealAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Must be >= the resulting endsAt"
          },
          "dailyPhotoLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "dailyVideoLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        }
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "example": "Juani"
          }
        },
        "required": [
          "name"
        ]
      },
      "MediaRegistered": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending"
            ]
          },
          "upload": {
            "type": "object",
            "properties": {
              "original": {
                "type": "string",
                "format": "uri",
                "description": "PUT of the original file"
              },
              "thumb": {
                "type": "string",
                "format": "uri",
                "description": "PUT of the JPEG thumbnail (~800px)"
              }
            },
            "required": [
              "original",
              "thumb"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "description": "Seconds the URLs stay valid"
          }
        },
        "required": [
          "id",
          "status",
          "upload",
          "expiresIn"
        ]
      },
      "MediaStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploaded"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "RegisterMediaRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID generated on the phone; retrying with the same id is safe"
          },
          "type": {
            "$ref": "#/components/schemas/MediaType"
          },
          "takenAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Phone time when the shot was taken",
            "example": 1767225600000
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "accuracyM": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "caption": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 280
          },
          "thumbhash": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "description": "ThumbHash (https://evanw.github.io/thumbhash/) in standard base64, generated on the phone from the thumbnail. If a retry brings a different value, the first one is kept.",
            "example": "3OcRJYB4d3h/iIeHeEh3eIhw+j3A"
          },
          "durationS": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "type",
          "takenAt",
          "sizeBytes"
        ]
      },
      "MediaType": {
        "type": "string",
        "enum": [
          "photo",
          "video"
        ]
      },
      "Feed": {
        "type": "object",
        "properties": {
          "revealed": {
            "type": "boolean"
          },
          "revealAt": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            }
          }
        },
        "required": [
          "revealed",
          "revealAt",
          "items"
        ]
      },
      "FeedItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/MediaType"
          },
          "takenAt": {
            "type": "integer"
          },
          "day": {
            "type": "string",
            "example": "2027-01-12"
          },
          "lat": {
            "type": [
              "number",
              "null"
            ]
          },
          "lng": {
            "type": [
              "number",
              "null"
            ]
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbhash": {
            "type": [
              "string",
              "null"
            ],
            "description": "ThumbHash in base64. Always returned, also before the reveal, on purpose: it only encodes blurry colors (~25 bytes), the photo cannot be reconstructed from it."
          },
          "durationS": {
            "type": [
              "number",
              "null"
            ]
          },
          "author": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "width": {
            "type": [
              "number",
              "null"
            ],
            "description": "Only after the reveal"
          },
          "height": {
            "type": [
              "number",
              "null"
            ],
            "description": "Only after the reveal"
          },
          "files": {
            "type": "object",
            "properties": {
              "thumb": {
                "type": "string"
              },
              "original": {
                "type": "string"
              }
            },
            "required": [
              "thumb",
              "original"
            ],
            "description": "Download paths; only after the reveal"
          }
        },
        "required": [
          "id",
          "type",
          "takenAt",
          "day",
          "lat",
          "lng",
          "caption",
          "thumbhash",
          "durationS",
          "author"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/trips": {
      "post": {
        "tags": [
          "Trips"
        ],
        "summary": "Create a trip",
        "description": "Whoever creates it becomes the admin. Returns the invite code and the admin token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTripRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trip created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripCreated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trips/join": {
      "post": {
        "tags": [
          "Trips"
        ],
        "summary": "Join a trip",
        "description": "With the code and a name. The name is unique per trip (case-insensitive).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinTripRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Joined the trip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripCreated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict with the current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{tripId}": {
      "get": {
        "tags": [
          "Trips"
        ],
        "summary": "Trip info",
        "description": "Trip, members and how many photos and videos you have left today.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "tripId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Trip detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Trips"
        ],
        "summary": "Edit the trip (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "tripId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTripRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trip updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{tripId}/reveal": {
      "post": {
        "tags": [
          "Trips"
        ],
        "summary": "Reveal the roll now (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "tripId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Roll revealed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{tripId}/members/me": {
      "patch": {
        "tags": [
          "Trips"
        ],
        "summary": "Change your name in the trip",
        "description": "Same rules as when joining: unique per trip, case-insensitive.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "tripId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Name updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict with the current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{tripId}/members/{memberId}": {
      "delete": {
        "tags": [
          "Trips"
        ],
        "summary": "Remove someone from the trip (admin)",
        "description": "Their token stops working and their name is freed. Their photos stay in the roll.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "tripId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "memberId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Member removed"
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{tripId}/media": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Register a photo or video",
        "description": "Returns signed URLs to upload the original and the thumbnail straight to R2. Idempotent by `id`: retrying from the offline queue neither duplicates nor spends quota.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "tripId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterMediaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retry: new URLs, or it was already uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
