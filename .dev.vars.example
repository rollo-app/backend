R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret

# Subidas al R2 local en `npm run dev` (nunca en producción)
DEV_LOCAL_UPLOADS=1

# Opcionales. Sin RESEND_API_KEY el código de login aparece en la consola de wrangler.
# RESEND_API_KEY=re_xxx
# Base del link mágico del mail (default https://rollo.juanifraga.com/entrar)
# LOGIN_LINK_URL=https://rollo.juanifraga.com/entrar
# Cuenta de App Review (a ese email no se le manda nada; REVIEW_CODE es su código)
# REVIEW_EMAIL=review@example.com
# REVIEW_CODE=K7M2QX
# Denuncias: destino del mail (default soporte@juanifraga.com) y token de /admin/*
# REPORTS_EMAIL=soporte@example.com
# ADMIN_TOKEN=un_token_largo_y_secreto
# Tope de almacenamiento en bytes (default 10000000000 = 10 GB, el límite gratis de R2); las subidas nuevas se frenan al 95%
# STORAGE_LIMIT_BYTES=10000000000
