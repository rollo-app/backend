{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rollo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Base de datos (SQLite en Cloudflare). Pegá acá el id que te da
  // `npx wrangler d1 create rollo`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rollo",
      "database_id": "13f35fe4-d442-4ff2-a0fc-e895537561ef",
      "migrations_dir": "migrations"
    }
  ],

  // Storage de fotos y videos.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rollo-media"
    }
  ],

  // Rate limiting (Workers Rate Limiting binding; limits are per Cloudflare location). Keys and usage: src/lib/rate-limit.ts.
  "ratelimits": [
    // Every request: per session (Bearer token) or per IP when anonymous.
    { "name": "RL_GLOBAL", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    // Per IP for requests with a token (backstop against invented tokens).
    { "name": "RL_IP", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } },
    // Per user: media registration/completion, avatar upload, likes, adding members.
    { "name": "RL_EXPENSIVE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    // Per user: file downloads (a gallery loads many thumbnails).
    { "name": "RL_FILES", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } }
  ],

  "vars": {
    "R2_BUCKET_NAME": "rollo-media",
    // Secret (npx wrangler secret put CF_ANALYTICS_TOKEN): token con "Account Analytics: Read"; sin él no se mide el uso de Cloudflare.
    "D1_DATABASE_ID": "13f35fe4-d442-4ff2-a0fc-e895537561ef",
    "EMAIL_FROM": "Rollo <rollo@juanifraga.com>"
  },

  // Dominio propio. Un solo nivel de subdominio para que lo cubra el
  // certificado gratis de Cloudflare (*.juanifraga.com).
  "routes": [
    { "pattern": "rollo-api.juanifraga.com", "custom_domain": true }
  ],

  // Cron cada 5 min: avisos de "arrancó" / "se reveló" y recibos de Expo (tokens muertos).
  // En local: `npm run dev -- --test-scheduled` y `curl "http://localhost:8787/__scheduled?cron=*/5+*+*+*+*"`.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }

  // Secrets (no van acá; se cargan con `npx wrangler secret put <NOMBRE>`):
  //   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
  // Opcionales:
  //   RESEND_API_KEY            envío de los códigos de login (sin esto solo se loguean en consola)
  //   REPORTS_EMAIL             destino de las denuncias (default soporte@juanifraga.com)
  //   ADMIN_TOKEN               token de las rutas /admin/* (borrar fotos y cuentas denunciadas)
  //   LOGIN_LINK_URL            base del link mágico del mail (default https://rollo.juanifraga.com/entrar)
  //   REVIEW_EMAIL, REVIEW_CODE cuenta para App Review: a ese email no se le manda nada y REVIEW_CODE es su código
}
