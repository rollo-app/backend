{
  "name": "rollo-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0 --local-upstream $(ipconfig getifaddr en0):8787 --upstream-protocol http",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "db:migrate:local": "wrangler d1 migrations apply rollo --local",
    "db:migrate:remote": "wrangler d1 migrations apply rollo --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx scripts/export-openapi.ts",
    "seed": "tsx scripts/seed-with-server.ts",
    "seed:only": "tsx scripts/seed.ts",
    "db:check-schema": "tsx scripts/check-schema.ts",
    "email:preview": "tsx scripts/email-preview.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261019.1",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  }
}
